t = lower_first.wrapping_add(extent.count).wrapping_sub(1);\n\n    idx = 0;\n    while idx < new_map.nr_extents {\n        let prev_upper_first: u32;\n        let prev_lower_first: u32;\n        let prev_upper_last: u32;\n        let prev_lower_last: u32;\n        let prev: UidGidExtent;\n\n        // :761-764 — the third of the four union dispatch sites.\n        if new_map.nr_extents <= UID_GID_MAP_MAX_BASE_EXTENTS as u32 {\n            prev = new_map.extent[idx as usize];\n        } else {\n            prev = new_map.forward[idx as usize];\n        }\n\n        prev_upper_first = prev.first;\n        prev_lower_first = prev.lower_first;\n        // WRAPPING (:768, :769).\n        prev_upper_last = prev_upper_first.wrapping_add(prev.count).wrapping_sub(1);\n        prev_lower_last = prev_lower_first.wrapping_add(prev.count).wrapping_sub(1);\n\n        // Does the upper range intersect a previous extent? — :771-774\n        if prev_upper_first <= upper_last && prev_upper_last >= upper_first {\n            return true;\n        }\n\n        // Does the lower range intersect a previous extent? — :776-779\n        if prev_lower_first <= lower_last && prev_lower_last >= lower_first {\n            return true;\n        }\n        idx += 1;\n    }\n    return false;\n}","attr_info":{"attributes":[{"DocComment":" `mappings_overlap`, kernel/user_namespace.c:745-782."},{"DocComment":""},{"DocComment":" Checks the candidate extent against every extent already inserted, in"},{"DocComment":" **both** coordinates: upper at :771-774, lower at :776-779. Note that in"},{"DocComment":" `map_write` this runs at :1038, BEFORE the re-mapping loop at :1063-1083"},{"DocComment":" overwrites `lower_first` — so the lower-range check here constrains the"},{"DocComment":" parent-namespace ids, not the kernel-global ids the map ends up holding"},{"DocComment":" (SPEC §1.5)."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"re