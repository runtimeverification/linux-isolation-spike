"},{"DocComment":" into the array. The two call sites (:292, :381) only ever read `->first`"},{"DocComment":" and `->lower_first` from the result and never write through it, so copying"},{"DocComment":" is semantics-preserving; and Aeneas rejects references nested in `Option`"},{"DocComment":" (prior spike barriers 2-3)."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":627},{"HashConsedValue":[1244,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":612},"Shared"]}]},{"Deduplicated":484}],"output":{"HashConsedValue":[859,{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[{"Deduplicated":493}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":207,"col":0},"end":{"line":232,"col":1}},"generated_from_span":null},"bound_body_regions":7,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":211,"col":5},"end":{"line":211,"col":25}},"generated_from_span":null},"ty":{"Deduplicated":859}},{"index":1,"name":"key","span":{"data":{"file_id":0,"beg":{"line":208,"col":4},"end":{"line":208,"col":7}},"generated_from_span":null},"ty":{"Deduplicated":627}},{"index":2,"name":"arr","span":{"data":{"file_id":0,"beg":{"line":209,"col":4},"end":{"line":209,"col":7}},"generated_from_span":null},"ty":{"HashConsedValue":[862,{"Ref":[{"Body":1},{"Deduplicated":612},"Shared"]}]}},{"index":3,"name":"nmemb","span":{"data":{"file_id":0,"beg":{"line":210,"col":4},"end":{"line":210,"col":9}},"generated_from_span":null},"ty":{"Deduplicated":484}},{"index":4,"name":"lo","span":{"data":{"file_id":0,"beg":{"line":212,"col":8},"end"