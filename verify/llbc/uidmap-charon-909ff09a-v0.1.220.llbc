59},"end":{"line":577,"col":60}},"generated_from_span":null},"id":1619,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":578,"col":15},"end":{"line":578,"col":16}},"generated_from_span":null},"id":1620,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":635}},{"Use":[{"Const":{"kind":{"Literal":{"Scalar":{"Signed":["I32","0"]}}},"ty":{"Deduplicated":635}}},"Yes"]}]},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":579,"col":4},"end":{"line":579,"col":5}},"generated_from_span":null},"id":1621,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":598,"col":1},"end":{"line":598,"col":1}},"generated_from_span":null},"id":1623,"kind":"Return","comments_before":[]}]},"comments":[[584,["Sort forward array. — :862-863"]],[587,["Only copy the memory from forward we actually need. — :865-869"]],[595,["Sort reverse array. — :871-873"]]]}}},{"def_id":18,"item_meta":{"name":[{"Ident":["uidmap",0]},{"Ident":["map_write_body",0]}],"span":{"data":{"file_id":0,"beg":{"line":622,"col":0},"end":{"line":756,"col":1}},"generated_from_span":null},"source_text":"fn map_write_body(\n    map: &mut UidGidMap,\n    parent_map: &UidGidMap,\n    lines: &[UidGidExtent],\n    cap_ok: bool,\n    permitted: bool,\n    new_map: &mut UidGidMap,\n) -> i32 {\n    let mut ret: i32;\n    let mut idx: u32;\n\n    ret = -EPERM;\n    // Only allow one successful write to the map — :980\n    if map.nr_extents != 0 {\n        return ret;\n    }\n\n    // Adjusting namespace settings requires capabilities on the target. — :986\n    if !cap_ok {\n        return ret;\n    }\n\n    // Parse the user data — :990-1049\n    ret = -EINVAL;\n    let mut i: usize = 0;\n    while i < lines.len() {\n        let extent: UidGidExtent = lines[i];\n        let has_next_line: bool = i + 1 < lines.len();\n\n        // Verify we have been given valid starting values — :1024-1026.\n        // SPEC §1.2.1: redundant given :1031/:1033, since first == (u32)-1\n        // with count >= 1 wraps. Kept because the C keeps it.\n        if extent.first == ID_SENTINEL || extent.lower_first == ID_SENTINEL {\n            return ret;\n        }\n\n        // Verify count is not zero and does not cause the extent to wrap —\n        // :1028-1034. WRAPPING: the u32 sum is compared against `first`; SPEC\n        // §1.2.1 shows this accepts exactly count >= 1 && first + count <= 2^32-1.\n        if extent.first.wrapping_add(extent.count) <= extent.first {\n            return ret;\n        }\n        if extent.lower_first.wrapping_add(extent.count) <= extent.lower_first {\n            return ret;\n        }\n\n        // Do the ranges in extent overlap any previous extents? — :1038\n        if mappings_overlap(new_map, &extent) {\n            return ret;\n        }\n\n        // :1041-1043 — the 340 cap. Exactly 340 extents fit; a 341st line fails.\n        if new_map.nr_extents + 1 == UID_GID_MAP_MAX_EXTENTS as u32 && has_next_line {\n            return ret;\n        }\n\n        ret = insert_extent(new_map, &extent);\n        if ret < 0 {\n            return ret;\n        }\n        ret = -EINVAL;\n        i += 1;\n    }\n    // Be very certain the new map actually exists — :1052-1054\n    if new_map.nr_extents == 0 {\n        return ret;\n    }\n\n    ret = -EPERM;\n    // Validate the user is allowed to use user id's mapped to. — :1056\n    if !permitted {\n        return ret;\n    }\n\n    ret = -EPERM;\n    // Map the lower ids from the parent user namespace to the kernel global\n    // id space. — :1063-1083. This is where lower_first is REWRITTEN (SPEC §1.5).\n    idx = 0;\n    while idx < new_map.nr_extents {\n        let e: UidGidExtent;\n        let lower_first: u32;\n\n        // :1067-1070 — the fourth union dispatch site is verify_root_map's;\n        // this one mirrors :761-764.\n        if new_map.nr_extents <= UID_GID_MAP_MAX_BASE_EXTENTS as u32 {\n            e = new_map.extent[idx as usize];\n        } else {\n            e = new_map.forward[idx as usize];\n        }\n\n        lower_first = map_id_range_down(parent_map, e.lower_first, e.count);\n\n        // Fail if we can not map the specified extent to the kernel global\n        // id space. — :1079-1080\n        if lower_first == ID_SENTINEL {\n            return ret;\n        }\n\n        // `e->lower_first = lower_first;` — :1082\n        if new_map.nr_extents <= UID_GID_MAP_MAX_BASE_EXTENTS as u32 {\n            new_map.extent[idx as usize].lower_first = lower_first;\n        } else {\n            new_map.forward[idx as usize].lower_first = lower_first;\n        }\n        idx += 1;\n    }\n\n    // If we want to use binary search for lookup, this clones the extent\n    // array and sorts both copies. — :1089-1091\n    ret = sort_idmaps(new_map);\n    if ret < 0 {\n        return ret;\n    }\n\n    // Install the map — :1094-1102\n    if new_map.nr_extents <= UID_GID_MAP_MAX_BASE_EXTENTS as u32 {\n        // memcpy(map->extent, new_map.extent, nr * sizeof(...)) — :1095-1096\n        let mut k: u32 = 0;\n        while k < new_map.nr_extents {\n            map.extent[k as usize] = new_map.extent[k as usize];\n            k += 1;\n        }\n    } else {\n        // map->forward = new_map.forward; map->reverse = new_map.reverse; — :1098-1099\n        map.forward = new_map.forward;\n        map.reverse = new_map.reverse;\n        map.forward_live = new_map.forward_live;\n        map.reverse_live = new_map.reverse_live;\n    }\n    // MODEL: smp_wmb() (:1101) — the publication barrier. Assumption A-PUB.\n    map.nr_extents = new_map.nr_extents;\n\n    // *ppos = count; ret = count; — :1103-1104. DEVIATION: byte count not modelled.\n    return 0;\n}","attr_info":{"attributes":[{"DocComment":" The body of `map_write` from the first parsed extent to the install,"},{"DocComment":" kernel/user_namespace.c:975-1102, **on already-parsed extents**."},{"DocComment":""},{"DocComment":" SCOPE (ROADMAP Amendment 2): the `__user` copy (:947-952), the"},{"DocComment":" line-splitting and `simple_strtoul` parsing (:995-1020) and the mutex are"},{"DocComment":" outside the model. The input `lines` is the sequence of `(first,"},{"DocComment":" lower_first, count)` triples the parser would have produced, one per line,"},{"DocComment":" in order. `next_line != NULL` at :1042 becomes `i + 1 < lines.len()`."},{"DocComment":""},{"DocComment":" `A-CAPORACLE`: `cap_ok` stands for"},{"DocComment":" `!(cap_valid(cap_setid) && !file_ns_capable(file, map_ns, CAP_SYS_ADMIN))`"},{"DocComment":" at :986, and `permitted` for `new_idmap_permitted(...)` at :1056. Both are"},{"DocComment":" inputs here; step 6 replaces `permitted` with the real function over an"},{"DocComment":" oracle."},{"DocComment":""},{"DocComment":" Return: `0` on success (DEVIATION: the C returns the byte count written,"},{"DocComment":" which the model does not have), `-EPERM` / `-EINVAL` as the C. The"},{"DocComment":" `goto out` cleanup at :1107-1113 is performed by the caller `map_write`."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"},{"index":3,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1246},{"HashConsedValue":[1249,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":621},"Shared"]}]},{"HashConsedValue":[1250,{"Ref":[{"Var":{"Free":2}},{"HashConsedValue":[896,{"Slice":{"Deduplicated":493}}]},"Shared"]}]},{"Deduplicated":591},{"Deduplicated":591},{"HashConsedValue":[1251,{"Ref":[{"Var":{"Free":3}},{"Deduplicated":621},"Mut"]}]}],"output":{"Deduplicated":635}},"src":"TopLevel","is_global_initializer":null,"b