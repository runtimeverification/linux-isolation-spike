pointers. The"},{"DocComment":" consequence is that the `-ENOMEM` paths at :798 and :868 are unreachable"},{"DocComment":" here; see SPEC §7 item 6."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":88,"col":4},"end":{"line":88,"col":60}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Union arm 1: `extent[UID_GID_MAP_MAX_BASE_EXTENTS]`."}],"inline":null,"rename":null,"public":true},"name":"extent","ty":{"HashConsedValue":[565,{"Array":[{"HashConsedValue":[448,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","5"]}}},"ty":{"HashConsedValue":[439,{"Literal":{"UInt":"Usize"}}]}}]}]}},{"span":{"data":{"file_id":0,"beg":{"line":90,"col":4},"end":{"line":90,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Union arm 2: `*forward`, sorted by `first` once `sort_idmaps` has run."}],"inline":null,"rename":null,"public":true},"name":"forward","ty":{"HashConsedValue":[567,{"Array":[{"Deduplicated":448},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","340"]}}},"ty":{"Deduplicated":439}}]}]}},{"span":{"data":{"file_id":0,"beg":{"line":92,"col":4},"end":{"line":92,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Union arm 2: `*reverse`, sorted by `lower_first`."}],"inline":null,"rename":null,"public":true},"name":"reverse","ty":{"Deduplicated":567}},{"span":{"data":{"file_id":0,"beg":{"line":94,"col":4},"end":{"line":94,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" MODEL: `map->forward != NULL`."}],"inline":null,"rename":null,"public":true},"name":"forward_live","ty":{"HashConsedValue":[