omments_before":[]}]},"comments":[[166,["WRAPPING (:255). `key->id + key->count - 1` is u32 arithmetic. It wraps","when the caller hands in a range crossing 2^32; SPEC §4.1 is the","statement that it does not wrap for ranges that hit a well-formed map."]],[169,["handle map_id_{down,up}() — :262-266"]],[176,["WRAPPING (:269). `first + el->count - 1`."]]]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["uidmap",0]},{"Ident":["bsearch_extent",0]}],"span":{"data":{"file_id":0,"beg":{"line":207,"col":0},"end":{"line":232,"col":1}},"generated_from_span":null},"source_text":"fn bsearch_extent(\n    key: IdmapKey,\n    arr: &[UidGidExtent; UID_GID_MAP_MAX_EXTENTS],\n    nmemb: usize,\n) -> Option<UidGidExtent> {\n    let mut lo: usize = 0;\n    let mut num: usize = nmemb;\n\n    while num > 0 {\n        let pivot: usize = lo + (num >> 1);\n        let result: i32 = cmp_map_id(key, &arr[pivot]);\n\n        if result == 0 {\n            return Some(arr[pivot]);\n        }\n\n        if result > 0 {\n            lo = pivot + 1;\n            num -= 1;\n        }\n\n        num >>= 1;\n    }\n\n    return None;\n}","attr_info":{"attributes":[{"DocComment":" `__inline_bsearch`, include/linux/bsearch.h:9-28, specialized to"},{"DocComment":" `(struct uid_gid_extent, cmp_map_id)`."},{"DocComment":""},{"DocComment":" The loop shape is preserved exactly, including the `num--` on the"},{"DocComment":" greater-than branch *before* the unconditional `num >>= 1` — the site"},{"DocComment":" where an off-by-one would live (SPEC §4.4 obligation 2). Pointer"},{"DocComment":" arithmetic becomes index arithmetic: `base` is `lo`, `pivot` is an index,"},{"DocComment":" and `+ size` is `+ 1`."},{"DocComment":""},{"DocComment":" DEVIATION: returns `Option<UidGidExtent>` (a copy) rather than a pointer"},{"DocComment":" into the array. The two call sites (:292, :381) only ever read `->first`"},{"DocComment":" and `->lower_first` from the result and never write through it, so copying"},{"DocComment":" 